[core]
  autocrlf = input
  whitespace = error
  compression = 9
  preloadindex = true
  pager = diff-so-fancy | less --tabs=4 -RFX

[alias]
  st = "status -sb"
  logg = "log --graph --all --pretty=format:'%C(auto)%h %C(auto) %an  %ar%C(auto)  %D%n%s%n'"

[advice]
  addEmptyPathspec = false
  pushNonFastForward = false
  statusHints = false

[color]
  ui = true

[fetch]
  prune = true

[init]
  defaultBranch = "main"
  templateDir = ~/.git-templates

[commit]
  verbose = true

[pull]
  rebase = true
  default = current

[push]
  autoSetupRemote = true
  default = current
  followTags = true

[pager]
  branch = false
  diff = diff-so-fancy | $PAGER

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[rebase]
  autoStash = true
  missingCommitsCheck = warn

[log]
  abbrevCommit = true
  graphColors = blue,yellow,cyan,magenta,green,red

[diff]
  colorMoved = "default"
  renames = copies
  interHunkContext = 10

[diff-so-fancy]
  markEmptyLines = false
  first-run = false

[color "diff"]
  frag = magenta bold
  context    = white
  whitespace = red reverse
  meta = yellow
  commit = yellow bold
  old = red bold
  new = green bold

[interactive]
  diffFilter = diff-so-fancy --patch
  singlekey = true

[format]
  pretty = "%C(auto)%h %C(auto) %an  %ar%C(auto)  %D%n%s%n"

[color "decorate"]
  HEAD = red
  branch = blue
  tag = yellow
  remoteBranch = magenta

[color "branch"]
    current  = magenta
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue


[include]
  path = ~/.gitconfig

[url "git@github.com:"]
	insteadOf = https://github.com/

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22
